APP_NAME="Meshwork HQ"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meshworkhq
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. `log` writes messages to storage/logs/laravel.log and delivers nothing,
# which is fine locally but means no verification links reach anyone. Switch to
# `resend` and set RESEND_API_KEY to actually send.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@meshworkhq.com"
MAIL_FROM_NAME="${APP_NAME}"

# Must be publicly reachable: an inbox cannot load a localhost URL.
# Falls back to APP_URL + /images/meshwork-lockup.png when unset.
MAIL_LOGO_URL=

# The from address above must be on a domain verified in the Resend dashboard,
# otherwise Resend rejects the send.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paystack. Test keys start sk_test_ / pk_test_, live keys sk_live_ / pk_live_.
# Credit purchasing stays hidden in the wallet until the secret key is present.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Only loaded in production, and only when set.
GOOGLE_ANALYTICS_ID=
